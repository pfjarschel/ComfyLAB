{
  "name": "Bode Measure Point",
  "type_name": "builtin/cluster/bode_measure_point",
  "category": "Clusters",
  "icon": "\ud83d\udcc8",
  "display_name": "Bode Measure Point",
  "description": "Sets excitation frequency on Minipa generator, auto-adjusts scope timebase, acquires CH1/CH2, and calculates Gain (dB) and Vpp.",
  "internal_blueprint": {
    "blocks": [
      {
        "id": "boundary_exec_in",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "In",
          "Type": "exec"
        },
        "position": {
          "x": 0,
          "y": 100
        }
      },
      {
        "id": "boundary_in_mfg_dev",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "MinipaDevice",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 250
        }
      },
      {
        "id": "boundary_in_scope_dev",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "ScopeDevice",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 400
        }
      },
      {
        "id": "boundary_in_freq",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Frequency",
          "Type": "data",
          "DataType": "number"
        },
        "position": {
          "x": 0,
          "y": 550
        }
      },
      {
        "id": "block_mfg_wave",
        "type": "devices/minipa/mfg4230/config_wave",
        "properties": {
          "Channel": 1,
          "Shape": "SINE",
          "Amplitude": 2.0,
          "Offset": 0.0,
          "Phase": 0.0
        },
        "position": {
          "x": 300,
          "y": 100
        }
      },
      {
        "id": "block_calc_timebase",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"freq\" type=\"number\" default=1000.0\n# @output name=\"scale\" type=\"number\"\n\n# Auto-adjust oscilloscope horizontal timebase scale (s/div)\nscale = max(1e-9, 0.2 / max(float(freq), 1.0))\n",
          "customInputs": [
            {
              "name": "freq",
              "type": "number",
              "default": 1000
            }
          ],
          "customOutputs": [
            {
              "name": "scale",
              "type": "number"
            }
          ]
        },
        "position": {
          "x": 600,
          "y": 100
        }
      },
      {
        "id": "block_tbs_timebase",
        "type": "devices/tektronix/tbs1062/timebase",
        "properties": {
          "Scale": 0.001,
          "Position": 0.0
        },
        "position": {
          "x": 900,
          "y": 100
        }
      },
      {
        "id": "block_settle_sleep",
        "type": "control_flow/timing/sleep",
        "properties": {
          "Delay": 0.05
        },
        "position": {
          "x": 1200,
          "y": 100
        }
      },
      {
        "id": "block_acq_ch1",
        "type": "devices/tektronix/tbs1062/acquire",
        "properties": {
          "Channel": 1
        },
        "position": {
          "x": 1500,
          "y": 100
        }
      },
      {
        "id": "block_acq_ch2",
        "type": "devices/tektronix/tbs1062/acquire",
        "properties": {
          "Channel": 2
        },
        "position": {
          "x": 1800,
          "y": 100
        }
      },
      {
        "id": "block_calc_gain",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"ch1\" type=\"ndarray\"\n# @input name=\"ch2\" type=\"ndarray\"\n# @input name=\"freq\" type=\"number\"\n# @output name=\"gain_db\" type=\"number\"\n# @output name=\"vpp_in\" type=\"number\"\n# @output name=\"vpp_out\" type=\"number\"\n\nimport numpy as np\n\nv_in = float(np.ptp(ch1)) if len(ch1) > 0 else 1.0\nv_out = float(np.ptp(ch2)) if len(ch2) > 0 else 0.0\n\nvpp_in = v_in\nvpp_out = v_out\nratio = max(v_out / max(v_in, 1e-6), 1e-6)\ngain_db = float(20.0 * np.log10(ratio))\n",
          "customInputs": [
            {
              "name": "ch1",
              "type": "ndarray"
            },
            {
              "name": "ch2",
              "type": "ndarray"
            },
            {
              "name": "freq",
              "type": "number"
            }
          ],
          "customOutputs": [
            {
              "name": "gain_db",
              "type": "number"
            },
            {
              "name": "vpp_in",
              "type": "number"
            },
            {
              "name": "vpp_out",
              "type": "number"
            }
          ]
        },
        "position": {
          "x": 2100,
          "y": 100
        }
      },
      {
        "id": "boundary_exec_out",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Out",
          "Type": "exec"
        },
        "position": {
          "x": 2400,
          "y": 100
        }
      },
      {
        "id": "boundary_out_gain",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Gain_dB",
          "Type": "data"
        },
        "position": {
          "x": 2400,
          "y": 250
        }
      },
      {
        "id": "boundary_out_vin",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Vin_Vpp",
          "Type": "data"
        },
        "position": {
          "x": 2400,
          "y": 400
        }
      },
      {
        "id": "boundary_out_vout",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Vout_Vpp",
          "Type": "data"
        },
        "position": {
          "x": 2400,
          "y": 550
        }
      }
    ],
    "links": [
      {
        "id": "link_bin_exec_to_wave",
        "type": "exec",
        "source_block": "boundary_exec_in",
        "source_pin": "Out",
        "target_block": "block_mfg_wave",
        "target_pin": "In"
      },
      {
        "id": "link_bin_mfg_dev_to_wave",
        "type": "data",
        "source_block": "boundary_in_mfg_dev",
        "source_pin": "Value",
        "target_block": "block_mfg_wave",
        "target_pin": "Device"
      },
      {
        "id": "link_bin_freq_to_wave",
        "type": "data",
        "source_block": "boundary_in_freq",
        "source_pin": "Value",
        "target_block": "block_mfg_wave",
        "target_pin": "Frequency"
      },
      {
        "id": "link_wave_to_calc_timebase",
        "type": "exec",
        "source_block": "block_mfg_wave",
        "source_pin": "Out",
        "target_block": "block_calc_timebase",
        "target_pin": "In"
      },
      {
        "id": "link_bin_freq_to_calc_timebase",
        "type": "data",
        "source_block": "boundary_in_freq",
        "source_pin": "Value",
        "target_block": "block_calc_timebase",
        "target_pin": "freq"
      },
      {
        "id": "link_calc_timebase_to_tbs_timebase",
        "type": "exec",
        "source_block": "block_calc_timebase",
        "source_pin": "Out",
        "target_block": "block_tbs_timebase",
        "target_pin": "In"
      },
      {
        "id": "link_bin_scope_dev_to_timebase",
        "type": "data",
        "source_block": "boundary_in_scope_dev",
        "source_pin": "Value",
        "target_block": "block_tbs_timebase",
        "target_pin": "Device"
      },
      {
        "id": "link_scale_to_timebase",
        "type": "data",
        "source_block": "block_calc_timebase",
        "source_pin": "scale",
        "target_block": "block_tbs_timebase",
        "target_pin": "Scale"
      },
      {
        "id": "link_timebase_to_sleep",
        "type": "exec",
        "source_block": "block_tbs_timebase",
        "source_pin": "Out",
        "target_block": "block_settle_sleep",
        "target_pin": "In"
      },
      {
        "id": "link_sleep_to_acq_ch1",
        "type": "exec",
        "source_block": "block_settle_sleep",
        "source_pin": "Out",
        "target_block": "block_acq_ch1",
        "target_pin": "In"
      },
      {
        "id": "link_bin_scope_dev_to_acq_ch1",
        "type": "data",
        "source_block": "boundary_in_scope_dev",
        "source_pin": "Value",
        "target_block": "block_acq_ch1",
        "target_pin": "Device"
      },
      {
        "id": "link_acq_ch1_to_acq_ch2",
        "type": "exec",
        "source_block": "block_acq_ch1",
        "source_pin": "Out",
        "target_block": "block_acq_ch2",
        "target_pin": "In"
      },
      {
        "id": "link_bin_scope_dev_to_acq_ch2",
        "type": "data",
        "source_block": "boundary_in_scope_dev",
        "source_pin": "Value",
        "target_block": "block_acq_ch2",
        "target_pin": "Device"
      },
      {
        "id": "link_acq_ch2_to_calc_gain",
        "type": "exec",
        "source_block": "block_acq_ch2",
        "source_pin": "Out",
        "target_block": "block_calc_gain",
        "target_pin": "In"
      },
      {
        "id": "link_acq_ch1_to_calc_gain",
        "type": "data",
        "source_block": "block_acq_ch1",
        "source_pin": "Waveform",
        "target_block": "block_calc_gain",
        "target_pin": "ch1"
      },
      {
        "id": "link_acq_ch2_to_calc_gain",
        "type": "data",
        "source_block": "block_acq_ch2",
        "source_pin": "Waveform",
        "target_block": "block_calc_gain",
        "target_pin": "ch2"
      },
      {
        "id": "link_bin_freq_to_calc_gain",
        "type": "data",
        "source_block": "boundary_in_freq",
        "source_pin": "Value",
        "target_block": "block_calc_gain",
        "target_pin": "freq"
      },
      {
        "id": "link_calc_gain_to_bout_exec",
        "type": "exec",
        "source_block": "block_calc_gain",
        "source_pin": "Out",
        "target_block": "boundary_exec_out",
        "target_pin": "In"
      },
      {
        "id": "link_calc_gain_to_bout_gain",
        "type": "data",
        "source_block": "block_calc_gain",
        "source_pin": "gain_db",
        "target_block": "boundary_out_gain",
        "target_pin": "Value"
      },
      {
        "id": "link_calc_gain_to_bout_vin",
        "type": "data",
        "source_block": "block_calc_gain",
        "source_pin": "vpp_in",
        "target_block": "boundary_out_vin",
        "target_pin": "Value"
      },
      {
        "id": "link_calc_gain_to_bout_vout",
        "type": "data",
        "source_block": "block_calc_gain",
        "source_pin": "vpp_out",
        "target_block": "boundary_out_vout",
        "target_pin": "Value"
      }
    ]
  },
  "boundary_pins": {
    "exec_ins": [
      {
        "name": "In",
        "maps_to": {
          "block_id": "boundary_exec_in",
          "pin": "Out"
        }
      }
    ],
    "exec_outs": [
      {
        "name": "Out",
        "maps_from": {
          "block_id": "boundary_exec_out",
          "pin": "In"
        }
      }
    ],
    "data_ins": [
      {
        "name": "MinipaDevice",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_mfg_dev",
          "pin": "Value"
        }
      },
      {
        "name": "ScopeDevice",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_scope_dev",
          "pin": "Value"
        }
      },
      {
        "name": "Frequency",
        "type": "number",
        "default": 1000.0,
        "maps_to": {
          "block_id": "boundary_in_freq",
          "pin": "Value"
        }
      }
    ],
    "data_outs": [
      {
        "name": "Gain_dB",
        "type": "number",
        "maps_from": {
          "block_id": "boundary_out_gain",
          "pin": "Value"
        }
      },
      {
        "name": "Vin_Vpp",
        "type": "number",
        "maps_from": {
          "block_id": "boundary_out_vin",
          "pin": "Value"
        }
      },
      {
        "name": "Vout_Vpp",
        "type": "number",
        "maps_from": {
          "block_id": "boundary_out_vout",
          "pin": "Value"
        }
      }
    ]
  }
}