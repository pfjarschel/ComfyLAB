{
  "name": "Franck-Hertz Export Dataset",
  "type_name": "builtin/cluster/fh_export_dataset",
  "category": "Clusters",
  "icon": "💾",
  "display_name": "Franck-Hertz Export Dataset",
  "description": "Packs accelerating voltage (Ua), collector current (Is), retarding voltage (Us), and temperature (T) arrays and saves as timestamped CSV.",
  "internal_blueprint": {
    "blocks": [
      {
        "id": "boundary_exec_in",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Write",
          "Type": "exec"
        },
        "position": {
          "x": 0,
          "y": 100
        }
      },
      {
        "id": "boundary_in_ua",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Ua_V",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 250
        }
      },
      {
        "id": "boundary_in_is",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Is_nA",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 400
        }
      },
      {
        "id": "boundary_in_us",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Us_V",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 550
        }
      },
      {
        "id": "boundary_in_temp",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Temp_C",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 700
        }
      },
      {
        "id": "block_path_gen",
        "type": "File I\\/O/path_generator",
        "properties": {
          "Prefix": "IFGW_F740_FranckHertz",
          "Extension": ".csv",
          "Subfolder": "data/franck_hertz",
          "FormatPattern": "%Y-%m-%d_%H%M%S"
        },
        "position": {
          "x": 300,
          "y": 100
        }
      },
      {
        "id": "block_pack",
        "type": "Numeric Arrays/manipulation/pack",
        "properties": {
          "itemCount": 4
        },
        "position": {
          "x": 300,
          "y": 350
        }
      },
      {
        "id": "block_headers",
        "type": "Lists/manipulation/create",
        "properties": {
          "Row 0": "Tensao Ua (V), Corrente Is (nA), Tensao Us (V), Temperatura (C)",
          "ParseNumbers": false,
          "itemCount": 1
        },
        "position": {
          "x": 300,
          "y": 650
        }
      },
      {
        "id": "block_save_csv",
        "type": "File I\\/O/save_csv",
        "properties": {
          "Transpose": true,
          "Append": false
        },
        "position": {
          "x": 600,
          "y": 100
        }
      },
      {
        "id": "boundary_exec_out",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Out",
          "Type": "exec"
        },
        "position": {
          "x": 900,
          "y": 100
        }
      },
      {
        "id": "boundary_out_path",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "SavedPath",
          "Type": "data"
        },
        "position": {
          "x": 900,
          "y": 250
        }
      }
    ],
    "links": [
      {
        "id": "link_bin_exec_to_save",
        "type": "exec",
        "source_block": "boundary_exec_in",
        "source_pin": "Out",
        "target_block": "block_save_csv",
        "target_pin": "Write"
      },
      {
        "id": "link_path_to_save",
        "type": "data",
        "source_block": "block_path_gen",
        "source_pin": "FilePath",
        "target_block": "block_save_csv",
        "target_pin": "FilePath"
      },
      {
        "id": "link_bin_ua_to_pack",
        "type": "data",
        "source_block": "boundary_in_ua",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 0"
      },
      {
        "id": "link_bin_is_to_pack",
        "type": "data",
        "source_block": "boundary_in_is",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 1"
      },
      {
        "id": "link_bin_us_to_pack",
        "type": "data",
        "source_block": "boundary_in_us",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 2"
      },
      {
        "id": "link_bin_temp_to_pack",
        "type": "data",
        "source_block": "boundary_in_temp",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 3"
      },
      {
        "id": "link_pack_to_save",
        "type": "data",
        "source_block": "block_pack",
        "source_pin": "Array",
        "target_block": "block_save_csv",
        "target_pin": "Data"
      },
      {
        "id": "link_headers_to_save",
        "type": "data",
        "source_block": "block_headers",
        "source_pin": "List",
        "target_block": "block_save_csv",
        "target_pin": "Headers"
      },
      {
        "id": "link_save_to_bout_exec",
        "type": "exec",
        "source_block": "block_save_csv",
        "source_pin": "Out",
        "target_block": "boundary_exec_out",
        "target_pin": "In"
      },
      {
        "id": "link_path_to_bout_path",
        "type": "data",
        "source_block": "block_path_gen",
        "source_pin": "FilePath",
        "target_block": "boundary_out_path",
        "target_pin": "Value"
      }
    ]
  },
  "boundary_pins": {
    "exec_ins": [
      {
        "name": "Write",
        "maps_to": {
          "block_id": "boundary_exec_in",
          "pin": "Out"
        }
      }
    ],
    "exec_outs": [
      {
        "name": "Out",
        "maps_from": {
          "block_id": "boundary_exec_out",
          "pin": "In"
        }
      }
    ],
    "data_ins": [
      {
        "name": "Ua_V",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_ua",
          "pin": "Value"
        }
      },
      {
        "name": "Is_nA",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_is",
          "pin": "Value"
        }
      },
      {
        "name": "Us_V",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_us",
          "pin": "Value"
        }
      },
      {
        "name": "Temp_C",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_temp",
          "pin": "Value"
        }
      }
    ],
    "data_outs": [
      {
        "name": "SavedPath",
        "type": "text",
        "maps_from": {
          "block_id": "boundary_out_path",
          "pin": "Value"
        }
      }
    ]
  }
}
