{
  "name": "Franck-Hertz Setup Instruments",
  "type_name": "builtin/cluster/fh_setup_instruments",
  "category": "Clusters",
  "icon": "🔌",
  "display_name": "Franck-Hertz Setup Instruments",
  "description": "Initializes VISA serial connection for Franck-Hertz apparatus (ASRL / USB-Serial) with selectable Simulation / Real Hardware switch.",
  "internal_blueprint": {
    "blocks": [
      {
        "id": "boundary_exec_in",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "In",
          "Type": "exec"
        },
        "position": {
          "x": 0,
          "y": 100
        }
      },
      {
        "id": "boundary_in_addr",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Address",
          "Type": "data",
          "DataType": "text"
        },
        "position": {
          "x": 0,
          "y": 250
        }
      },
      {
        "id": "boundary_in_sim",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Simulation",
          "Type": "data",
          "DataType": "boolean"
        },
        "position": {
          "x": 0,
          "y": 400
        }
      },
      {
        "id": "block_if_sim",
        "type": "control_flow/basic/if_else",
        "properties": {
          "Condition": false
        },
        "position": {
          "x": 260,
          "y": 100
        }
      },
      {
        "id": "block_visa_dev",
        "type": "visa/core/device",
        "properties": {
          "Address": "ASRL/dev/ttyUSB0::INSTR",
          "ReadTermination": "",
          "WriteTermination": "\n",
          "Timeout": 2.0
        },
        "position": {
          "x": 520,
          "y": 150
        }
      },
      {
        "id": "block_write_safe_d",
        "type": "visa/core/write",
        "properties": {
          "Command": "D"
        },
        "position": {
          "x": 780,
          "y": 150
        }
      },
      {
        "id": "block_write_safe_p",
        "type": "visa/core/write",
        "properties": {
          "Command": "P"
        },
        "position": {
          "x": 1040,
          "y": 150
        }
      },
      {
        "id": "block_write_start_s",
        "type": "visa/core/write",
        "properties": {
          "Command": "s"
        },
        "position": {
          "x": 1300,
          "y": 150
        }
      },
      {
        "id": "boundary_exec_out",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Out",
          "Type": "exec"
        },
        "position": {
          "x": 1580,
          "y": 100
        }
      },
      {
        "id": "boundary_out_dev",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Device",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 1580,
          "y": 250
        }
      },
      {
        "id": "boundary_out_sim",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Simulation",
          "Type": "data",
          "DataType": "boolean"
        },
        "position": {
          "x": 1580,
          "y": 400
        }
      }
    ],
    "links": [
      {
        "id": "link_bin_exec_to_if",
        "type": "exec",
        "source_block": "boundary_exec_in",
        "source_pin": "Out",
        "target_block": "block_if_sim",
        "target_pin": "In"
      },
      {
        "id": "link_bin_sim_to_if_cond",
        "type": "data",
        "source_block": "boundary_in_sim",
        "source_pin": "Value",
        "target_block": "block_if_sim",
        "target_pin": "Condition"
      },
      {
        "id": "link_if_sim_true_to_bout_exec",
        "type": "exec",
        "source_block": "block_if_sim",
        "source_pin": "True",
        "target_block": "boundary_exec_out",
        "target_pin": "In"
      },
      {
        "id": "link_if_sim_false_to_visa_open",
        "type": "exec",
        "source_block": "block_if_sim",
        "source_pin": "False",
        "target_block": "block_visa_dev",
        "target_pin": "Open"
      },
      {
        "id": "link_bin_addr_to_visa_addr",
        "type": "data",
        "source_block": "boundary_in_addr",
        "source_pin": "Value",
        "target_block": "block_visa_dev",
        "target_pin": "Address"
      },
      {
        "id": "link_visa_dev_to_write_d",
        "type": "exec",
        "source_block": "block_visa_dev",
        "source_pin": "Out",
        "target_block": "block_write_safe_d",
        "target_pin": "In"
      },
      {
        "id": "link_visa_dev_to_write_d_dev",
        "type": "data",
        "source_block": "block_visa_dev",
        "source_pin": "Device",
        "target_block": "block_write_safe_d",
        "target_pin": "Device"
      },
      {
        "id": "link_write_d_to_write_p",
        "type": "exec",
        "source_block": "block_write_safe_d",
        "source_pin": "Out",
        "target_block": "block_write_safe_p",
        "target_pin": "In"
      },
      {
        "id": "link_visa_dev_to_write_p_dev",
        "type": "data",
        "source_block": "block_visa_dev",
        "source_pin": "Device",
        "target_block": "block_write_safe_p",
        "target_pin": "Device"
      },
      {
        "id": "link_write_p_to_write_s",
        "type": "exec",
        "source_block": "block_write_safe_p",
        "source_pin": "Out",
        "target_block": "block_write_start_s",
        "target_pin": "In"
      },
      {
        "id": "link_visa_dev_to_write_s_dev",
        "type": "data",
        "source_block": "block_visa_dev",
        "source_pin": "Device",
        "target_block": "block_write_start_s",
        "target_pin": "Device"
      },
      {
        "id": "link_write_s_to_bout_exec",
        "type": "exec",
        "source_block": "block_write_start_s",
        "source_pin": "Out",
        "target_block": "boundary_exec_out",
        "target_pin": "In"
      },
      {
        "id": "link_visa_dev_to_bout_dev",
        "type": "data",
        "source_block": "block_visa_dev",
        "source_pin": "Device",
        "target_block": "boundary_out_dev",
        "target_pin": "Value"
      },
      {
        "id": "link_bin_sim_to_bout_sim",
        "type": "data",
        "source_block": "boundary_in_sim",
        "source_pin": "Value",
        "target_block": "boundary_out_sim",
        "target_pin": "Value"
      }
    ]
  },
  "boundary_pins": {
    "exec_ins": [
      {
        "name": "In",
        "maps_to": {
          "block_id": "boundary_exec_in",
          "pin": "Out"
        }
      }
    ],
    "exec_outs": [
      {
        "name": "Out",
        "maps_from": {
          "block_id": "boundary_exec_out",
          "pin": "In"
        }
      }
    ],
    "data_ins": [
      {
        "name": "Address",
        "type": "text",
        "default": "ASRL/dev/ttyUSB0::INSTR",
        "widget": "text",
        "optional": false,
        "maps_to": {
          "block_id": "boundary_in_addr",
          "pin": "Value"
        }
      },
      {
        "name": "Simulation",
        "type": "boolean",
        "default": true,
        "widget": "toggle",
        "optional": false,
        "maps_to": {
          "block_id": "boundary_in_sim",
          "pin": "Value"
        }
      }
    ],
    "data_outs": [
      {
        "name": "Device",
        "type": "any",
        "maps_from": {
          "block_id": "boundary_out_dev",
          "pin": "Value"
        }
      },
      {
        "name": "Simulation",
        "type": "boolean",
        "maps_from": {
          "block_id": "boundary_out_sim",
          "pin": "Value"
        }
      }
    ]
  }
}
