{
  "name": "Horiba VUV Export Dataset",
  "type_name": "builtin/cluster/vuv_export_dataset",
  "category": "Clusters",
  "icon": "💾",
  "display_name": "Horiba VUV Export Dataset",
  "description": "Packs Wavelength (nm), Power (mW), Power (dBm), and Std Dev arrays and saves as timestamped CSV file in data/horiba_vuv/.",
  "internal_blueprint": {
    "blocks": [
      {
        "id": "boundary_exec_in",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Write",
          "Type": "exec"
        },
        "position": {
          "x": 0,
          "y": 100
        }
      },
      {
        "id": "boundary_in_wl",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Wavelength_Array",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 250
        }
      },
      {
        "id": "boundary_in_pmw",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Power_mW_Array",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 400
        }
      },
      {
        "id": "boundary_in_pdbm",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "Power_dBm_Array",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 550
        }
      },
      {
        "id": "boundary_in_std",
        "type": "cluster/boundary/input",
        "properties": {
          "Name": "StdDev_Array",
          "Type": "data",
          "DataType": "any"
        },
        "position": {
          "x": 0,
          "y": 700
        }
      },
      {
        "id": "block_path_gen",
        "type": "File I\\/O/path_generator",
        "properties": {
          "Prefix": "Horiba_H20_VUV_Spectrum",
          "Extension": ".csv",
          "Subfolder": "data/horiba_vuv",
          "FormatPattern": "%Y-%m-%d_%H%M%S"
        },
        "position": {
          "x": 300,
          "y": 100
        }
      },
      {
        "id": "block_pack",
        "type": "Numeric Arrays/manipulation/pack",
        "properties": {
          "itemCount": 4
        },
        "position": {
          "x": 300,
          "y": 350
        }
      },
      {
        "id": "block_headers",
        "type": "Lists/manipulation/create",
        "properties": {
          "Row 0": "Wavelength (nm),Power (mW),Power (dBm), Std. devs",
          "ParseNumbers": false,
          "itemCount": 1
        },
        "position": {
          "x": 300,
          "y": 650
        }
      },
      {
        "id": "block_save_csv",
        "type": "File I\\/O/save_csv",
        "properties": {
          "Transpose": true,
          "Append": false
        },
        "position": {
          "x": 600,
          "y": 100
        }
      },
      {
        "id": "boundary_exec_out",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "Out",
          "Type": "exec"
        },
        "position": {
          "x": 900,
          "y": 100
        }
      },
      {
        "id": "boundary_out_path",
        "type": "cluster/boundary/output",
        "properties": {
          "Name": "SavedPath",
          "Type": "data"
        },
        "position": {
          "x": 900,
          "y": 250
        }
      }
    ],
    "links": [
      {
        "id": "link_bin_exec_to_save",
        "type": "exec",
        "source_block": "boundary_exec_in",
        "source_pin": "Out",
        "target_block": "block_save_csv",
        "target_pin": "Write"
      },
      {
        "id": "link_path_to_save",
        "type": "data",
        "source_block": "block_path_gen",
        "source_pin": "FilePath",
        "target_block": "block_save_csv",
        "target_pin": "FilePath"
      },
      {
        "id": "link_bin_wl_to_pack",
        "type": "data",
        "source_block": "boundary_in_wl",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 0"
      },
      {
        "id": "link_bin_pmw_to_pack",
        "type": "data",
        "source_block": "boundary_in_pmw",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 1"
      },
      {
        "id": "link_bin_pdbm_to_pack",
        "type": "data",
        "source_block": "boundary_in_pdbm",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 2"
      },
      {
        "id": "link_bin_std_to_pack",
        "type": "data",
        "source_block": "boundary_in_std",
        "source_pin": "Value",
        "target_block": "block_pack",
        "target_pin": "Item 3"
      },
      {
        "id": "link_pack_to_save",
        "type": "data",
        "source_block": "block_pack",
        "source_pin": "Array",
        "target_block": "block_save_csv",
        "target_pin": "Data"
      },
      {
        "id": "link_headers_to_save",
        "type": "data",
        "source_block": "block_headers",
        "source_pin": "List",
        "target_block": "block_save_csv",
        "target_pin": "Headers"
      },
      {
        "id": "link_save_to_bout_exec",
        "type": "exec",
        "source_block": "block_save_csv",
        "source_pin": "Out",
        "target_block": "boundary_exec_out",
        "target_pin": "In"
      },
      {
        "id": "link_path_to_bout_path",
        "type": "data",
        "source_block": "block_path_gen",
        "source_pin": "FilePath",
        "target_block": "boundary_out_path",
        "target_pin": "Value"
      }
    ]
  },
  "boundary_pins": {
    "exec_ins": [
      {
        "name": "Write",
        "maps_to": {
          "block_id": "boundary_exec_in",
          "pin": "Out"
        }
      }
    ],
    "exec_outs": [
      {
        "name": "Out",
        "maps_from": {
          "block_id": "boundary_exec_out",
          "pin": "In"
        }
      }
    ],
    "data_ins": [
      {
        "name": "Wavelength_Array",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_wl",
          "pin": "Value"
        }
      },
      {
        "name": "Power_mW_Array",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_pmw",
          "pin": "Value"
        }
      },
      {
        "name": "Power_dBm_Array",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_pdbm",
          "pin": "Value"
        }
      },
      {
        "name": "StdDev_Array",
        "type": "any",
        "maps_to": {
          "block_id": "boundary_in_std",
          "pin": "Value"
        }
      }
    ],
    "data_outs": [
      {
        "name": "SavedPath",
        "type": "text",
        "maps_from": {
          "block_id": "boundary_out_path",
          "pin": "Value"
        }
      }
    ]
  }
}
