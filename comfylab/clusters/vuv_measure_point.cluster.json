      {
        "id": "block_calc_hardware",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"waveform\" type=\"ndarray\"\n# @input name=\"target_wl\" type=\"number\" default=120.0\n# @input name=\"cal_factor\" type=\"number\" default=1.0\n# @output name=\"real_actual_wl\" type=\"number\"\n# @output name=\"real_power_mw\" type=\"number\"\n# @output name=\"real_power_dbm\" type=\"number\"\n# @output name=\"real_std_dev_v\" type=\"number\"\n# @output name=\"real_mean_voltage_v\" type=\"number\"\n\nimport math\nimport numpy as np\n\nwl = float(target_wl) if target_wl is not None else 120.0\ncal = float(cal_factor) if cal_factor is not None and float(cal_factor) != 0.0 else 1.0\n\nif waveform is not None and len(waveform) > 0:\n    mean_v = float(np.mean(waveform))\n    std_v = float(np.std(waveform))\nelse:\n    mean_v = 0.0\n    std_v = 0.0\n\np_lin = mean_v / cal\nif p_lin > 0.0:\n    p_log = 10.0 * math.log10(p_lin)\nelse:\n    p_log = -200.0\n\nreal_actual_wl = float(wl)\nreal_power_mw = float(p_lin)\nreal_power_dbm = float(p_log)\nreal_std_dev_v = float(std_v)\nreal_mean_voltage_v = float(mean_v)\n",
          "customInputs": [
            {
              "name": "waveform",
              "type": "ndarray"
            },
            {
              "name": "target_wl",
              "type": "number",
              "default": 120.0
            },
            {
              "name": "cal_factor",
              "type": "number",
              "default": 1.0
            }
          ],
          "customOutputs": [
            {
              "name": "real_actual_wl",
              "type": "number"
            },
            {
              "name": "real_power_mw",
              "type": "number"
            },
            {
              "name": "real_power_dbm",
              "type": "number"
            },
            {
              "name": "real_std_dev_v",
              "type": "number"
            },
            {
              "name": "real_mean_voltage_v",
              "type": "number"
            }
          ]
        },
        "position": {
          "x": 1360,
          "y": 280
        }
