      {
        "id": "block_sim_measure",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"target_wl\" type=\"number\" default=120.0\n# @input name=\"cal_factor\" type=\"number\" default=1.0\n# @output name=\"sim_actual_wl\" type=\"number\"\n# @output name=\"sim_power_mw\" type=\"number\"\n# @output name=\"sim_power_dbm\" type=\"number\"\n# @output name=\"sim_std_dev_v\" type=\"number\"\n# @output name=\"sim_mean_voltage_v\" type=\"number\"\n\nimport math\nimport numpy as np\n\nwl = float(target_wl) if target_wl is not None else 120.0\ncal = float(cal_factor) if cal_factor is not None and float(cal_factor) != 0.0 else 1.0\n\n# Synthetic VUV emission spectrum simulation (Lyman-alpha at 121.57 nm + molecular H2 bands + continuum)\nlyman_alpha = 4.5 * math.exp(-((wl - 121.567) / 0.8) ** 2)\nmol_band = 1.8 * math.exp(-((wl - 160.0) / 12.0) ** 2)\ncontinuum = 0.5 * math.exp(-((wl - 140.0) / 35.0) ** 2) + 0.08\nnoise = float(np.random.normal(0, 0.005))\nsim_signal = max(0.001, lyman_alpha + mol_band + continuum + noise)\n\nmean_v = float(sim_signal)\nstd_v = float(abs(np.random.normal(0.003, 0.0005)))\np_lin = mean_v / cal\n\nif p_lin > 0.0:\n    p_log = 10.0 * math.log10(p_lin)\nelse:\n    p_log = -200.0\n\nsim_actual_wl = float(wl)\nsim_power_mw = float(p_lin)\nsim_power_dbm = float(p_log)\nsim_std_dev_v = float(std_v)\nsim_mean_voltage_v = float(mean_v)\n",
          "customInputs": [
            {
              "name": "target_wl",
              "type": "number",
              "default": 120.0
            },
            {
              "name": "cal_factor",
              "type": "number",
              "default": 1.0
            }
          ],
          "customOutputs": [
            {
              "name": "sim_actual_wl",
              "type": "number"
            },
            {
              "name": "sim_power_mw",
              "type": "number"
            },
            {
              "name": "sim_power_dbm",
              "type": "number"
            },
            {
              "name": "sim_std_dev_v",
              "type": "number"
            },
            {
              "name": "sim_mean_voltage_v",
              "type": "number"
            }
          ]
        },
        "position": {
          "x": 600,
          "y": 40
        }
      },
