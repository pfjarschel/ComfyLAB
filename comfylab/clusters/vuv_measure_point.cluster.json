        "type": "script/python",
        "properties": {
          "code": "# @input name=\"simulation\" type=\"boolean\" default=false\n# @input name=\"sim_actual_wl\" type=\"number\" default=120.0\n# @input name=\"sim_power_mw\" type=\"number\" default=0.0\n# @input name=\"sim_power_dbm\" type=\"number\" default=-200.0\n# @input name=\"sim_std_dev_v\" type=\"number\" default=0.0\n# @input name=\"sim_mean_voltage_v\" type=\"number\" default=0.0\n# @input name=\"real_actual_wl\" type=\"number\" default=120.0\n# @input name=\"real_power_mw\" type=\"number\" default=0.0\n# @input name=\"real_power_dbm\" type=\"number\" default=-200.0\n# @input name=\"real_std_dev_v\" type=\"number\" default=0.0\n# @input name=\"real_mean_voltage_v\" type=\"number\" default=0.0\n# @output name=\"out_wl\" type=\"number\"\n# @output name=\"out_power_mw\" type=\"number\"\n# @output name=\"out_power_dbm\" type=\"number\"\n# @output name=\"out_std_dev_v\" type=\"number\"\n# @output name=\"out_mean_voltage_v\" type=\"number\"\n\nif bool(simulation):\n    out_wl = float(sim_actual_wl)\n    out_power_mw = float(sim_power_mw)\n    out_power_dbm = float(sim_power_dbm)\n    out_std_dev_v = float(sim_std_dev_v)\n    out_mean_voltage_v = float(sim_mean_voltage_v)\nelse:\n    out_wl = float(real_actual_wl)\n    out_power_mw = float(real_power_mw)\n    out_power_dbm = float(real_power_dbm)\n    out_std_dev_v = float(real_std_dev_v)\n    out_mean_voltage_v = float(real_mean_voltage_v)\n",
          "customInputs": [
            {
