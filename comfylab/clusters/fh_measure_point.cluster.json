      {
        "id": "block_decode_visa",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"raw_ua_resp\" type=\"text\" default=\"\"\n# @input name=\"raw_is_resp\" type=\"text\" default=\"\"\n# @input name=\"raw_us_resp\" type=\"text\" default=\"\"\n# @input name=\"raw_temp_resp\" type=\"text\" default=\"\"\n# @output name=\"visa_ua\" type=\"number\"\n# @output name=\"visa_is\" type=\"number\"\n# @output name=\"visa_us\" type=\"number\"\n# @output name=\"visa_temp\" type=\"number\"\n\ndef parse_adc(resp):\n    if not resp:\n        return 0\n    if isinstance(resp, str):\n        b = resp.encode(\"latin1\", errors=\"ignore\")\n    else:\n        b = bytes(resp)\n    if len(b) >= 2:\n        return (b[1] & 0x03) << 8 | b[0]\n    elif len(b) == 1:\n        return b[0]\n    return 0\n\nraw_ua = parse_adc(raw_ua_resp)\nraw_is = parse_adc(raw_is_resp)\nraw_us = parse_adc(raw_us_resp)\nraw_t = parse_adc(raw_temp_resp)\n\nvisa_ua = float(raw_ua * (50.0 / 1023.0))\nvisa_is = float((raw_is * (50.0 / 1023.0)) / (1e7 * 550.0) * 1e9)\nvisa_us = float((raw_us * (50.0 / 1023.0)) / (10.0 * 1.66667))\nvisa_temp = float(raw_t * (50.0 / 1023.0) * 5.12)\n",
          "customInputs": [
            {
              "name": "raw_ua_resp",
              "type": "text",
              "default": ""
            },
            {
              "name": "raw_is_resp",
              "type": "text",
              "default": ""
            },
            {
              "name": "raw_us_resp",
              "type": "text",
              "default": ""
            },
            {
              "name": "raw_temp_resp",
              "type": "text",
              "default": ""
            }
          ],
          "customOutputs": [
            {
              "name": "visa_ua",
              "type": "number"
            },
            {
              "name": "visa_is",
              "type": "number"
            },
            {
              "name": "visa_us",
              "type": "number"
            },
            {
              "name": "visa_temp",
              "type": "number"
            }
          ]
