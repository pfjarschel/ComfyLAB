          "code": "# @input name=\"simulation\" type=\"boolean\" default=true\n# @input name=\"sim_ua\" type=\"number\" default=0.0\n# @input name=\"sim_is\" type=\"number\" default=0.0\n# @input name=\"sim_us\" type=\"number\" default=0.0\n# @input name=\"sim_temp\" type=\"number\" default=0.0\n# @input name=\"visa_ua\" type=\"number\" default=0.0\n# @input name=\"visa_is\" type=\"number\" default=0.0\n# @input name=\"visa_us\" type=\"number\" default=0.0\n# @input name=\"visa_temp\" type=\"number\" default=0.0\n# @output name=\"ua_v\" type=\"number\"\n# @output name=\"is_na\" type=\"number\"\n# @output name=\"us_v\" type=\"number\"\n# @output name=\"temp_c\" type=\"number\"\n\nif bool(simulation):\n    ua_v = float(sim_ua)\n    is_na = float(sim_is)\n    us_v = float(sim_us)\n    temp_c = float(sim_temp)\nelse:\n    ua_v = float(visa_ua)\n    is_na = float(visa_is)\n    us_v = float(visa_us)\n    temp_c = float(visa_temp)\n",
