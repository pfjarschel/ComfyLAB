      {
        "id": "block_sim_physics",
        "type": "script/python",
        "properties": {
          "code": "# @input name=\"step\" type=\"number\" default=0.0\n# @output name=\"sim_ua\" type=\"number\"\n# @output name=\"sim_is\" type=\"number\"\n# @output name=\"sim_us\" type=\"number\"\n# @output name=\"sim_temp\" type=\"number\"\n\nimport math\nimport numpy as np\n\nst = float(step) if step is not None else 0.0\n# In simulation, step counter advances accelerating voltage linearly up to 50 V (0.5 V/step)\nua = min(50.0, st * 0.5)\nus = 1.5 + 0.02 * math.sin(st * 0.2)\ntemp = 175.0 + float(np.random.normal(0, 0.1))\n\nexc = 4.9  # Hg first excitation level (eV)\ncp = 2.3   # Tube contact potential (V)\npeak_current = 6.5  # nA\n\ntransmission = math.exp(-(temp - 150.0) / 30.0)\ntransmission = max(0.02, min(1.5, transmission))\n\nua_eff = max(0.0, ua - us) / 50.0\nbase = peak_current * transmission * (1.0 - math.exp(-ua_eff / 0.2))\n\ndip_depth = 0.70 * math.exp(-((temp - 170.0) / 40.0) ** 2)\ndip_depth = max(0.02, dip_depth)\ndip_width = 0.35 + 0.002 * temp\n\nfor n in range(1, 12):\n    vn = n * exc + us + cp\n    if vn > 55:\n        break\n    gauss = math.exp(-((ua - vn) / dip_width) ** 2)\n    base *= (1.0 - dip_depth * gauss)\n\nnoise_std = peak_current * 0.01 * transmission * 0.5\nbase += float(np.random.normal(0, noise_std))\nis_val = max(0.0, base)\n\nsim_ua = float(ua)\nsim_is = float(is_val)\nsim_us = float(us)\nsim_temp = float(temp)\n",
          "customInputs": [
            {
              "name": "step",
              "type": "number",
              "default": 0
            }
          ],
          "customOutputs": [
            {
              "name": "sim_ua",
              "type": "number"
            },
            {
              "name": "sim_is",
              "type": "number"
            },
            {
              "name": "sim_us",
              "type": "number"
            },
            {
              "name": "sim_temp",
              "type": "number"
            }
          ]
        },
        "position": {
          "x": 800,
          "y": 40
        }
